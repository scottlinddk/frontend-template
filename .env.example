# Public values only. Everything prefixed VITE_ is bundled into the client.

# Base path or URL of the backend API
VITE_API_BASE_URL=/api

# Auth provider: none | msal | clerk
VITE_AUTH_PROVIDER=none

# Required when VITE_AUTH_PROVIDER=msal
VITE_MSAL_CLIENT_ID=
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_MSAL_SCOPES=api://<api-client-id>/access_as_user

# Required when VITE_AUTH_PROVIDER=clerk
VITE_CLERK_PUBLISHABLE_KEY=

# Serve mock API responses from the browser (see src/mocks)
VITE_ENABLE_MSW=false
